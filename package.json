{
	"name": "content-series",
	"version": "0.9.2",
	"description": "A modern, block-editor-native WordPress plugin for managing content series.",
	"author": "Your Name",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"format": "wp-scripts format",
		"packages-update": "wp-scripts packages-update",
		"check-types": "tsc --noEmit",
		"check-types:tests": "tsc -p tsconfig.tests.json --noEmit",
		"env:start": "bin/scripts/wp-env-wrapper.sh start",
		"env:stop": "bin/scripts/wp-env-wrapper.sh stop",
		"env:clean": "bin/scripts/wp-env-wrapper.sh clean",
		"env:destroy": "bin/scripts/wp-env-wrapper.sh destroy",
		"test": "bin/scripts/wp-env-wrapper.sh run tests-cli --env-cwd=wp-content/plugins/plugin vendor/bin/phpunit",
		"test:watch": "bin/scripts/wp-env-wrapper.sh run tests-cli --env-cwd=wp-content/plugins/plugin vendor/bin/phpunit --watch",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:js:coverage": "wp-scripts test-unit-js --coverage",
		"test:e2e": "wp-scripts test-playwright --config=playwright.config.js",
		"test:e2e:ui": "wp-scripts test-playwright --config=playwright.config.js --ui",
		"test:e2e:debug": "wp-scripts test-playwright --config=playwright.config.js --debug"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.7",
		"@wordpress/env": "^10.37.0",
		"@wordpress/scripts": "^31.2.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.37.0",
		"@wordpress/block-editor": "^15.10.0",
		"@wordpress/blocks": "^15.10.0",
		"@wordpress/components": "^31.0.0",
		"@wordpress/compose": "^7.37.0",
		"@wordpress/core-data": "^7.37.0",
		"@wordpress/data": "^10.37.0",
		"@wordpress/editor": "^14.37.0",
		"@wordpress/element": "^6.37.0",
		"@wordpress/i18n": "^6.10.0",
		"@wordpress/plugins": "^7.37.0"
	}
}
