<?xml version="1.0"?>
<ruleset name="Content Series Plugin">
	<description>PHPCS configuration for Content Series WordPress plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude common non-PHP directories -->
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/.git/*</exclude-pattern>

	<!-- How to scan -->
	<!-- Usage instructions: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Usage -->
	<!-- Show progress and show sniff names on violation -->
	<arg value="p"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Rules: Check PHP version compatibility -->
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="7.4-8.4"/>
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#using-a-custom-ruleset -->
	<rule ref="PHPCompatibility"/>

	<!-- Rules: WordPress Coding Standards -->
	<!-- https://github.com/WordPress/WordPress-Coding-Standards -->
	<!-- https://github.com/WordPress/WordPress-Coding-Standards/wiki/Customizable-sniff-properties -->
	<config name="minimum_supported_wp_version" value="6.8"/>

	<!-- Set the text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="content-series"/>
			</property>
		</properties>
	</rule>

	<!-- Verify that everything in the global namespace is prefixed with a theme/plugin specific prefix.
		 Replace 'content-series' with your actual prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Content_Series"/>
			</property>
		</properties>
	</rule>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n"/>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing"/>
	<rule ref="WordPress.WhiteSpace.OperatorSpacing"/>
	<rule ref="WordPress.Arrays.ArrayIndentation"/>

	<!-- Allow short array syntax -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>

	<!-- Verify that no WP functions are used that are deprecated or have been removed.
		 The minimum version set here should be in line with the minimum WP version
		 supported by the plugin. -->
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>

	<!-- Check PHP cross-version compatibility -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Allow for some common 3rd party plugin/theme patterns -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>vendor/</exclude-pattern>
	</rule>
</ruleset>

