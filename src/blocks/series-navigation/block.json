{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "content-series/navigation",
	"version": "0.9.2",
	"title": "Series Navigation",
	"category": "theme",
	"description": "Wrapper block for previous/next navigation, series title, and series icon.",
	"textdomain": "content-series",
	"usesContext": [ "postId", "postType" ],
	"allowedBlocks": [
		"content-series/navigation-link",
		"content-series/series-title",
		"content-series/series-icon"
	],
	"supports": {
		"html": false,
		"color": {
			"link": true,
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"layout": {
			"default": {
				"type": "flex",
				"justifyContent": "space-between"
			},
			"allowSwitching": false,
			"allowInheriting": false
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
