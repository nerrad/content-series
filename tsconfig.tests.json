{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"composite": false,
		"types": [ "jest", "react" ]
	},
	"include": [
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		"tests/**/*.test.ts",
		"tests/**/*.test.tsx",
		"tests/**/*.spec.ts",
		"tests/**/*.spec.tsx",
		"tests/js/test-globals.d.ts"
	],
	"exclude": [ "**/build", "**/node_modules", "dist" ]
}
